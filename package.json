{
  "name": "dsh-swarm-scheduler",
  "version": "0.2.4",
  "description": "Parallel coding scheduler for DSH: a Lead that only schedules, teammates that only execute, and a file-backed ready pool with atomic claiming.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": { "default": "./lib/index.js" },
    "./client": { "default": "./lib/client.js" },
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "platform": "web"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json --noEmit && tsup",
    "prepare": "npm run build"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.4"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.4"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.4",
    "@deepseek-ai/dsh-tools": "0.2.0-rc.2",
    "@types/node": "^22.0.0",
    "tsup": "^8",
    "typescript": "^5.6.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/SadshiKoro/dsh-swarm-scheduler.git"
  },
  "author": "SadshiKoro",
  "license": "MIT"
}
